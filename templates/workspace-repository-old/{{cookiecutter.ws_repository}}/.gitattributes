# ========================
# CORE SETTINGS
# ========================
# Auto-detect text files and normalize line endings to LF on checkout (for cross-platform sanity)
* text=auto eol=lf

# ========================
# BINARY ARTIFACTS
# ========================
# Treat these as binaries; do not try to merge changes.
*.dll binary
*.pdb binary
*.exe binary
*.zip binary
*.7z  binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# ========================
# LANGUAGE SPECIFIC
# ========================
# Ensure specific text files always use LF
*.cs     text eol=lf
*.ts     text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.xml    text eol=lf
*.csproj text eol=lf
*.sln    text eol=lf
*.slnx   text eol=lf
*.md     text eol=lf

# ========================
# SHELL SCRIPTS
# ========================
# PowerShell scripts need BOM for some older versions, but UTF-8 is standard now.
*.ps1    text eol=lf
*.sh     text eol=lf
