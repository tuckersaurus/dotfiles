{
  "name": "workspace",
  "private": true,
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "workspaces": [
    "../source/{{cookiecutter.source_repo}}/dotnet/src/{{cookiecutter.source_project}}"
  ],
  "scripts": {
    "watch:{{cookiecutter.source_package}}": "npm --workspace=@{{cookiecutter.source_owner}}/{{cookiecutter.source_package}} run watch",
    "watch": "concurrently \"npm run watch:{{cookiecutter.source_package}}\""
  }
}
