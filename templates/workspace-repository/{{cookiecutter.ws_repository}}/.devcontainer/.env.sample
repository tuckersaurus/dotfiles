# Postgres superuser — used to initialize the container and run admin tasks.
# POSTGRES_USER must also match the superuser name in the VPS postgres container
# (used by .scripts/refresh-database.sh to run pg_dump remotely via docker exec).
# Does not need to match production app credentials.
POSTGRES_DB=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=

# App database connection — used by the workspace service and connection strings.
# DB_HOST: the postgres compose service name (not localhost)
# DB_SCHEMA: must match the production schema name (cross-schema queries depend on this)
# DB_USER / DB_PASSWORD: dev-specific service account; do not need to match production
DB_HOST=postgres
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=

# VPS SSH connection — used by .scripts/refresh-database.sh to fetch a production dump
VPS_USER=
VPS_HOST=
