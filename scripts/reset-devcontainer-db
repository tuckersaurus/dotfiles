#!/bin/bash
set -e

# Tears down the postgres container and data volume for a devcontainer workspace
# so that the next container rebuild re-runs the postgres init scripts from scratch.
#
# Run this from a WSL terminal (Docker is not available inside the devcontainer).
# After running, use "Rebuild Container" in VS Code to re-initialize the database.
#
# Usage: reset-devcontainer-db <workspace-name>
#   e.g. reset-devcontainer-db ws-zombie-miner

on_error() {
  echo "     ...failed on line $1!"
}

trap 'on_error $LINENO' ERR

WORKSPACE_NAME="${1:-}"

if [ -z "$WORKSPACE_NAME" ]; then
  echo "Usage: reset-devcontainer-db <workspace-name>"
  echo "  e.g. reset-devcontainer-db ws-zombie-miner"
  exit 1
fi

WORKSPACE_DIR=$(find ~/projects/source/github -maxdepth 2 -type d -name "$WORKSPACE_NAME" 2>/dev/null | head -1)

if [ -z "$WORKSPACE_DIR" ]; then
  echo "Error: workspace '$WORKSPACE_NAME' not found under ~/projects/source/github/"
  exit 1
fi

COMPOSE_FILE="$WORKSPACE_DIR/.devcontainer/docker-compose.yml"
PROJECT_NAME="${WORKSPACE_NAME}_devcontainer"

if [ ! -f "$COMPOSE_FILE" ]; then
  echo "Error: no .devcontainer/docker-compose.yml found in $WORKSPACE_DIR"
  exit 1
fi

echo "reset-devcontainer-db ..."
echo "     Workspace:  $WORKSPACE_DIR"
echo "     Project:    $PROJECT_NAME"
echo "     Stopping postgres and removing data volume..."
echo "     WARNING: This will destroy all local database data."
echo ""

docker compose -f "$COMPOSE_FILE" -p "$PROJECT_NAME" rm -sf postgres
docker compose -f "$COMPOSE_FILE" -p "$PROJECT_NAME" down -v 2>/dev/null || true

echo "     ...complete!"
echo ""
echo "Rebuild the devcontainer to re-initialize the database from .postgres/01-int.sql."
echo ""
